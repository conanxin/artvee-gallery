# Artvee Gallery · .gitignore
# Generic ignore rules for an open-source release.
# This file is intentionally project-agnostic; no machine paths embedded.

# === Source data: large original assets ===
images/
metadata/
previews/

# === Generated data: rebuildable from scripts ===
thumbs/
web/data/artworks.json
web/data/gallery_stats.json
web/data/digests.json
web/data/*.json.bak

# === Candidate pool / staging ===
inbox/

# === Export bundles: regenerated on demand ===
dist/
# Allow dist/.gitkeep as a directory placeholder
!dist/.gitkeep

# === Daily digests: regenerated on demand ===
digests/
# Allow digests/.gitkeep as a directory placeholder
!digests/.gitkeep

# === Local index files ===
index/

# === Logs, locks, temp files ===
logs/
*.lock
*.tmp
*.pid
.tmp_new_records.json

# === Backups / legacy copies ===
backups/
*.bak
*.bak.*
*.swp
*.swo

# === Python ===
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# === OS / editor cruft ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
